# Server
PORT=5000

# Paystack (https://dashboard.paystack.com/#/settings/developer)
PAYSTACK_PUBLIC_KEY=REPLACE_WITH_YOUR_PAYSTACK_PUBLIC_KEY
PAYSTACK_SECRET_KEY=REPLACE_WITH_YOUR_PAYSTACK_SECRET_KEY

# Paystack plan codes for each subscription tier (monthly + annual)
# Create these under Paystack Dashboard > Payments > Plans
PLAN_CODE_BASIC=PLN_xxxxxxxxxxxx
PLAN_CODE_PRO=PLN_xxxxxxxxxxxx
PLAN_CODE_ELITE=PLN_xxxxxxxxxxxx
PLAN_CODE_BASIC_ANNUAL=PLN_xxxxxxxxxxxx
PLAN_CODE_PRO_ANNUAL=PLN_xxxxxxxxxxxx
PLAN_CODE_ELITE_ANNUAL=PLN_xxxxxxxxxxxx

# Squad (https://dashboard.squadco.com) — second payment option at checkout.
# Squad has no auto-billing plan like Paystack: members pay per cycle and are
# reminded to renew. Get a sandbox key from Settings > API Keys once signed up.
SQUAD_SECRET_KEY=REPLACE_WITH_YOUR_SQUAD_SECRET_KEY
# Sandbox by default. Switch to https://api-d.squadco.com for production
# (together with a live secret key) once you're ready to go live.
SQUAD_BASE_URL=https://sandbox-api-d.squadco.com

# Google Sheets (used as the MVP database)
# Create one spreadsheet with three tabs: Members, Brands, Products
# Share the spreadsheet with the service account email below (Editor access)
GOOGLE_SHEET_ID=your_spreadsheet_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Paste the full private key, keeping \n escape sequences for line breaks
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Email (sends a confirmation email after a successful subscription).
# Gmail account + an App Password (not your normal password) — requires
# 2-Step Verification enabled: myaccount.google.com/apppasswords
SMTP_USER=your-business-gmail@gmail.com
SMTP_PASS=REPLACE_WITH_YOUR_GMAIL_APP_PASSWORD
# Used for the "browse brands" link in the confirmation email.
APP_BASE_URL=http://localhost:5000
# Only set this to true if sending fails with "self-signed certificate in
# certificate chain" — that means antivirus/corporate software on this
# machine is intercepting TLS traffic. Leave unset/false otherwise.
# SMTP_ALLOW_SELF_SIGNED=true

# Referral reward (Naira) credited to an existing member when someone they
# refer — matched by the referrer's exact member email in "Referred by" —
# completes a paid signup. It's a running ledger only (Members.ReferralCredits);
# there's no wallet or discount-code system, so credits are redeemed manually
# against an order like everything else in this MVP.
REFERRAL_REWARD_NAIRA=500

# How many days a member's "Lock this price" click freezes a product's
# member price for them, in case you raise it before they order.
PRICE_LOCK_DAYS=14

# A product's RetailPrice only counts toward the homepage savings claim if
# its RetailPriceCheckedAt (in the Products sheet) is within this many days
# — keeps that claim honest without relying on you remembering to update it.
RETAIL_PRICE_MAX_AGE_DAYS=30
